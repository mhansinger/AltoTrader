# ────────────────────────────────────────────────────────────────────
# AltoTrader – Hetzner environment template
#
# 1. Copy this file to .env in the project root:
#      cp env/.env.example .env
# 2. Fill in every XX placeholder
# 3. Never commit .env  (it is git-ignored)
# ────────────────────────────────────────────────────────────────────

# ── InfluxDB init (applied once on first startup) ───────────────────
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=XX_choose_a_strong_password
INFLUXDB_INIT_ORG=XX_your_org_name
INFLUXDB_INIT_BUCKET=altotrader
INFLUXDB_INIT_ADMIN_TOKEN=XX_choose_a_long_random_token

# ── InfluxDB write-only token (used by the streamer) ────────────────
# Create in InfluxDB UI → Data → API Tokens → Generate Token → Write only
# Scope it to the bucket above for least-privilege access.
# Falls back to INFLUXDB_INIT_ADMIN_TOKEN if not set.
INFLUXDB_WRITE_TOKEN=XX_write_only_token

# ── InfluxDB connection ──────────────────────────────────────────────
# Inside Docker Compose the streamer uses the internal hostname automatically.
# For scripts running outside Docker (fetch_from_remote.py, backups), set:
#   INFLUX_URL=http://localhost:8086   (via SSH tunnel: ssh -L 8086:localhost:8086 user@hetzner-ip)
INFLUX_URL=http://localhost:8086

# ── Streamer options ─────────────────────────────────────────────────
EXCHANGES=kraken,binance
MODE=rest

# ── Trading Bot (docker-compose.trader.yml) ──────────────────────────
TRADER_EXCHANGE=kraken
TRADER_PAIR=BTC-EUR
TRADER_WINDOW_SHORT=50
TRADER_WINDOW_LONG=200
TRADER_INITIAL_INVEST=1000
TRADER_POLL_INTERVAL=60
TRADER_PAPER_TRADING=true          # set to false for live trading

# Exchange API Keys (required for live trading only)
KRAKEN_API_KEY=XX_your_kraken_api_key
KRAKEN_API_SECRET=XX_your_kraken_api_secret
BINANCE_API_KEY=
BINANCE_API_SECRET=
